{
  include: [
    "syslog/client.shard.cml",
  ],
  program: {
    runner: "elf_test_runner",
    binary: "bin/primordialsoup",
    args: [ "pkg/data/TestRunner.vfuel" ],
  },
  capabilities: [
    { protocol: "fuchsia.test.Suite" },
  ],
  expose: [
    {
      protocol: "fuchsia.test.Suite",
      from: "self",
    },
  ],
}